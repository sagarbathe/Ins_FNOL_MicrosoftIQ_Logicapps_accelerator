# =============================================================================
# SECTION 1 ? REQUIRED: values you MUST fill in for your own environment.
# There is no safe/working default for these - the deployment script will
# fail, or use the wrong tenant/resources, if any of these are left blank.
# =============================================================================

# --- Your Azure subscription + Foundry project (see docs Section 6) ---
AZURE_SUBSCRIPTION_ID=
FOUNDRY_RESOURCE_GROUP=
FOUNDRY_ACCOUNT_NAME=
FOUNDRY_PROJECT_NAME=
FOUNDRY_PROJECT_ENDPOINT=

# --- Foundry IQ knowledge agent: reused if FOUNDRY_KNOWLEDGE_AGENT_ID is set, otherwise built ---
# Reuse path: set FOUNDRY_KNOWLEDGE_AGENT_ID (or FOUNDRY_KNOWLEDGE_AGENT_ID_FILE).
# Build path: leave those blank; Step 4 of deploy_solution.ps1 builds the search index and
# knowledge agent automatically and writes foundry/foundry_knowledge_agent_id.txt for you.
FOUNDRY_KNOWLEDGE_AGENT_ID=
FOUNDRY_KNOWLEDGE_AGENT_ID_FILE=

# --- Fabric workspace + Ontology data agent: reused if FABRIC_DATA_AGENT_ID/FABRIC_ONTOLOGY_ID
# are set, otherwise built ---
# Reuse path: set FABRIC_DATA_AGENT_ID and any existing ontology ids you already have.
# Build path: provide the blank workspace/lakehouse targets below and leave FABRIC_DATA_AGENT_ID/
# FABRIC_ONTOLOGY_ID blank; Steps 1-3 of deploy_solution.ps1 build them automatically, then copy
# the generated ids back into .env if you want them persisted for future reruns.
FABRIC_WORKSPACE_ID=
FABRIC_LAKEHOUSE_ID=
FABRIC_DATA_AGENT_ID=
FABRIC_ONTOLOGY_ID=
FABRIC_GRAPH_MODEL_ID=
FABRIC_LAKEHOUSE_DATA_LOADED=

# --- Fabric build-step names (required only when building Fabric IQ, i.e. FABRIC_DATA_AGENT_ID
# and FABRIC_ONTOLOGY_ID are left blank above) ---
FABRIC_ONTOLOGY_NAME=AutoFNOL_Ontology
DATAGEN_OUTPUT_DIR=datagen\output

# --- Foundry build-step values (required only when building Foundry IQ, i.e. FOUNDRY_KNOWLEDGE_AGENT_ID
# is left blank above) ---
# Create/register an Azure AI Search connection on the Foundry project ahead of time, then
# set its connection name here so create_foundry_agent.py can find it.
FOUNDRY_SEARCH_CONNECTION_NAME=
FOUNDRY_AGENT_NAME=auto-fnol-knowledge-agent
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_ADMIN_KEY=
AZURE_SEARCH_INDEX_NAME=auto-fnol-kb-index
AZURE_SEARCH_API_VERSION=2024-07-01
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_EMBEDDING_DIM=1536

# --- CaseThreadMap store (Fabric SQL Database in the same Fabric workspace,
# public endpoint, no VNet/Private Endpoint) - see shared/case_thread_store_schema.sql ---
CASETHREADMAP_FABRIC_SQL_ENDPOINT=<your-fabric-sql-db>.sql.azuresynapse.net
CASETHREADMAP_FABRIC_SQL_DATABASE=AutoFNOLTriageEventing
CASETHREADMAP_FABRIC_SQL_CONNECTION_STRING=

# --- Resource groups the script deploys into ---
WORKIQ_RESOURCE_GROUP=
LOGICAPP_RESOURCE_GROUP=

# --- Work IQ webapp's own shared API key - generate your own random string
# (e.g. `python -c "import secrets;print(secrets.token_urlsafe(24))"`) ---
WORKIQ_API_KEY=

# --- Entra app registration for Microsoft Graph app-only auth (Sites.Read.All,
# Mail.Read; used when AUTH_MODE=service_principal, and always used to manage
# Teams membership/mailbox setup for the Agent Identity below) ---
AAD_TENANT_ID=
AAD_CLIENT_ID=
AAD_CLIENT_SECRET=

# --- Agent Identity (dedicated mailbox + Teams member) ---
AGENT_IDENTITY_TENANT_ID=
AGENT_IDENTITY_UPN=
AGENT_IDENTITY_OBJECT_ID=
AGENT_IDENTITY_TOKEN_CACHE_PATH=
AGENT_IDENTITY_PUBLIC_CLIENT_ID=

# --- Teams target for case alerts ---
TEAMS_TEAM_ID=
TEAMS_CHANNEL_ID=


# =============================================================================
# SECTION 2 ? OPTIONAL: sensible defaults are already set below. Change these
# only if you need different names/regions/behavior than the accelerator's
# reference deployment.
# =============================================================================

FOUNDRY_MODEL_DEPLOYMENT=gpt-4o

ORCHESTRATOR_AGENT_NAME=auto-fnol-triage-orchestrator

FABRIC_ONTOLOGY_TOOL_OPENAPI_SPEC_PATH=

WORKIQ_API_KEY_CONNECTION_ID=

WORKIQ_BASE_URL=https://app-autofnol-workiq.azurewebsites.net
WORKIQ_WEBAPP_NAME=app-autofnol-workiq
WORKIQ_APP_SERVICE_PLAN=
WORKIQ_LOCATION=westus3
WORKIQ_SKU=B1
WORKIQ_PYTHON_VERSION=PYTHON:3.11

LOGICAPP_LOCATION=eastus2
LOGICAPP_EMAIL_INTAKE_NAME=la-fnol-email-intake
LOGICAPP_REPLY_POLLER_NAME=la-fnol-teams-reply-poller

GRAPH_SEARCH_REGION=NAM

AUTH_MODE=agent_identity
