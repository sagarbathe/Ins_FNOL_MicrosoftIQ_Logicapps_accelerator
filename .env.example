# Foundry project (reuse the same Azure AI Foundry project as Auto_FNOL_solution,
# or a new one - both work, since Fabric IQ/Foundry IQ are called as external
# tools/connected agents either way)
FOUNDRY_PROJECT_ENDPOINT=https://<your-project>.services.ai.azure.com
FOUNDRY_MODEL_DEPLOYMENT=gpt-4o

# Orchestrator agent name override (optional)
ORCHESTRATOR_AGENT_NAME=auto-fnol-triage-orchestrator

# Path to the EXISTING Foundry knowledge agent's id file from the sibling
# Auto_FNOL_solution repo (defaults to ../../Auto_FNOL_solution/foundry/agent_id.txt
# if left unset)
FOUNDRY_KNOWLEDGE_AGENT_ID_FILE=

# Fabric ontology data-agent OpenAPI spec path (defaults to
# foundry/fabric_ontology_openapi.json)
FABRIC_ONTOLOGY_TOOL_OPENAPI_SPEC_PATH=

# Foundry connection id for the Work IQ Graph-search Function (OpenAPI
# connection auth) - create via `az` / Foundry portal once the Function is
# deployed
WORKIQ_GRAPH_FUNCTION_CONNECTION_ID=

# Entra app registration used by shared/post_to_teams.py and
# foundry/tools_workiq_graph.py for Microsoft Graph app-only auth
# (ChannelMessage.Send, Sites.Read.All, Mail.Read, Chat.ReadWrite as needed)
AAD_TENANT_ID=
AAD_CLIENT_ID=
AAD_CLIENT_SECRET=

# Teams target for case alerts
TEAMS_TEAM_ID=
TEAMS_CHANNEL_ID=

# NOTE: this solution intentionally uses only public service endpoints with
# Entra ID auth - no VNet integration or Private Endpoints are configured or
# required for any component above.
