# =============================================================================
# SECTION 1 — REQUIRED: values you MUST fill in for your own environment.
# There is no safe/working default for these - the deployment script will
# fail, or use the wrong tenant/resources, if any of these are left blank.
# =============================================================================

# --- Your Azure subscription + Foundry project (see docs Section 6, Step 6/7) ---
AZURE_SUBSCRIPTION_ID=
FOUNDRY_RESOURCE_GROUP=
FOUNDRY_ACCOUNT_NAME=
FOUNDRY_PROJECT_NAME=
FOUNDRY_PROJECT_ENDPOINT=

# --- Existing Foundry IQ knowledge agent to reuse (set ONE of these two) ---
FOUNDRY_KNOWLEDGE_AGENT_ID=
FOUNDRY_KNOWLEDGE_AGENT_ID_FILE=

# --- Existing Fabric workspace + Ontology data agent (Fabric IQ) to reuse ---
FABRIC_WORKSPACE_ID=
FABRIC_DATA_AGENT_ID=

# --- CaseThreadMap store (Fabric SQL Database in the same Fabric workspace,
# public endpoint, no VNet/Private Endpoint) - see shared/case_thread_store_schema.sql ---
CASETHREADMAP_FABRIC_SQL_ENDPOINT=<your-fabric-sql-db>.sql.azuresynapse.net
CASETHREADMAP_FABRIC_SQL_DATABASE=AutoFNOLTriageEventing
CASETHREADMAP_FABRIC_SQL_CONNECTION_STRING=

# --- Resource groups the script deploys into (Step 5 / Step 8) ---
WORKIQ_RESOURCE_GROUP=
LOGICAPP_RESOURCE_GROUP=

# --- Work IQ webapp's own shared API key - generate your own random string
# (e.g. `python -c "import secrets;print(secrets.token_urlsafe(24))"`) ---
WORKIQ_API_KEY=

# --- Entra app registration for Microsoft Graph app-only auth (Sites.Read.All,
# Mail.Read; used when AUTH_MODE=service_principal, and always used to manage
# Teams membership/mailbox setup for the Agent Identity below) ---
AAD_TENANT_ID=
AAD_CLIENT_ID=
AAD_CLIENT_SECRET=

# --- Agent Identity (dedicated mailbox + Teams member) - see
# shared/agent_identity_auth.py. Run
# `python shared/agent_identity_auth.py --bootstrap` once (interactive
# device-code sign-in, including any required MFA enrollment) to populate
# the token cache file at AGENT_IDENTITY_TOKEN_CACHE_PATH. That cache file
# is a live credential - never commit it (see .gitignore's .secrets/ entry). ---
AGENT_IDENTITY_TENANT_ID=
AGENT_IDENTITY_UPN=
# Entra Object Id (GUID) of the Agent Identity user above - used by
# triggers/logicapp/deploy_logic_apps.py to filter the Agent Identity's own
# Teams posts out of the reply-poller so it never reacts to its own messages.
# Find it with: az ad user show --id <AGENT_IDENTITY_UPN> --query id -o tsv
AGENT_IDENTITY_OBJECT_ID=
AGENT_IDENTITY_TOKEN_CACHE_PATH=
# Dedicated public-client app registration for the device-code bootstrap +
# silent refresh. Register your own (sign-in audience "AzureADMyOrg",
# "Allow public client flows" = Yes) with delegated Graph permissions
# Mail.Read, Mail.Send, Sites.Read.All, Chat.Read, ChannelMessage.Send,
# ChannelMessage.Read.All (admin-consented) and delegated Fabric/Power BI
# permissions Item.Read.All, Item.Execute.All.
# Do NOT reuse the well-known Azure CLI client id here - it is a first-party
# Microsoft app that is not preauthorized for those Graph scopes and fails
# with AADSTS65002 ("must be configured via preauthorization").
AGENT_IDENTITY_PUBLIC_CLIENT_ID=

# --- Teams target for case alerts ---
TEAMS_TEAM_ID=
TEAMS_CHANNEL_ID=


# =============================================================================
# SECTION 2 — OPTIONAL: sensible defaults are already set below. Change these
# only if you need different names/regions/behavior than the accelerator's
# reference deployment.
# =============================================================================

# Foundry model deployment name used by the orchestrator agent
FOUNDRY_MODEL_DEPLOYMENT=gpt-4o

# Orchestrator agent display name
ORCHESTRATOR_AGENT_NAME=auto-fnol-triage-orchestrator

# Fabric ontology data-agent OpenAPI spec path (defaults to
# foundry/fabric_ontology_openapi.json if left blank)
FABRIC_ONTOLOGY_TOOL_OPENAPI_SPEC_PATH=

# Foundry connection id used by the orchestrator's Work IQ OpenAPI tool
# security scheme (created automatically by foundry/create_workiq_connection.py
# - leave blank unless you already created this yourself under a different name)
WORKIQ_API_KEY_CONNECTION_ID=

# Work IQ webapp App Service (auto-created by triggers/webapp/deploy_webapp.py
# if it doesn't already exist)
WORKIQ_BASE_URL=https://app-autofnol-workiq.azurewebsites.net
WORKIQ_WEBAPP_NAME=app-autofnol-workiq
# Optional overrides for the auto-created App Service Plan (defaults to
# asp-<webapp-name-without-"app-"> / westus3 / B1 / PYTHON:3.11 if left blank)
WORKIQ_APP_SERVICE_PLAN=
WORKIQ_LOCATION=westus3
WORKIQ_SKU=B1
WORKIQ_PYTHON_VERSION=PYTHON:3.11

# Logic Apps (Step 8 - Consumption Logic Apps deployed via ARM REST, see
# triggers/logicapp/deploy_logic_apps.py)
LOGICAPP_LOCATION=eastus2
LOGICAPP_EMAIL_INTAKE_NAME=la-fnol-email-intake
LOGICAPP_REPLY_POLLER_NAME=la-fnol-teams-reply-poller

# Azure geo required by the app-only Graph Search API call
GRAPH_SEARCH_REGION=NAM

# --- Auth mode selector (see docs/OBO_Bot_Teams_Design.docx, "Agent
# Identity" option vs. the original service-principal option) ---
# agent_identity     = a dedicated Entra ID user with its own mailbox and
#                      Teams membership; required for Fabric IQ ontology
#                      queries and Teams channel posting, both of which
#                      only support delegated (real user) auth, not
#                      app-only (see FNOL_Logicapps_Solution_Status.docx
#                      sections 4.4 and 4.6).
# service_principal  = original app-only ClientSecretCredential approach
#                      (works for Work IQ's Graph Search/Mail calls only).
AUTH_MODE=agent_identity

# NOTE: this solution intentionally uses only public service endpoints with
# Entra ID auth - no VNet integration or Private Endpoints are configured or
# required for any component above.
